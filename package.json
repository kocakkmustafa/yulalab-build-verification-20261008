{
  "name": "yulalab.com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "YULA Lab \u2014 umbrella corporate site showcasing the company's ventures.",
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "build": "pnpm verify:claims && pnpm verify:claims:local && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "export:registry": "tsx scripts/export-public-registry.ts",
    "verify:claims": "node --import tsx scripts/verify-public-registry.ts",
    "verify:links": "tsx scripts/verify-public-links.ts",
    "verify:claims:local": "node scripts/verify-claims-local.mjs",
    "verify:render-mode": "node scripts/verify-render-mode.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "15.5.27",
    "next-intl": "^4.11.1",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@netlify/plugin-nextjs": "5.16.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/three": "0.183.1",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.27",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "@tailwindcss/postcss": "4.3.3"
  },
  "pnpm": {
    "overrides": {
