# Public site origin used by sitemap, robots, OpenGraph and metadataBase.
# Production: https://yulalab.com
# Preview deployments fall back to VERCEL_URL automatically.
NEXT_PUBLIC_SITE_URL=https://yulalab.com

# ── Attribution (Y-P0-004) ────────────────────────────────────────────
# THE SWITCH for the whole funnel. Off unless set to exactly "1".
# NOTE: NEXT_PUBLIC_* is inlined at BUILD time — changing it in the Vercel
# dashboard does nothing until the next deploy. The links hub has its own
# `var ENABLED` in links/index.html; flip both in the same change, and update
# the "currently OFF" sentence on /privacy in that same change, or the public
# page starts lying (tests/privacy-claim-anchor.test.ts guards the hub half).
NEXT_PUBLIC_ATTRIBUTION_ENABLED=

# PostgreSQL for leads, consents and attribution. Deliberately SEPARATE
# from every product database — nothing here may be joined against LifeOS,
# Burun Farkı or Braavolabs user data.
#
# When this is unset, POST /api/events answers 503 {stored:false} rather
# than a silent 202. That is intentional: a 202 would make dropped events
# indistinguishable from stored ones and would inflate the
# attribution-completeness metric with rows that never existed.
# Distinct NOINHERIT login roles; no shared DATABASE_URL fallback.
YULA_DATABASE_SCHEMA=yulalab_private
YULA_INTAKE_DATABASE_URL=postgres://yula_intake:password@host:5432/yula_attribution
YULA_MAIL_DATABASE_URL=postgres://yula_mail:password@host:5432/yula_attribution
YULA_PURGE_DATABASE_URL=postgres://yula_purge:password@host:5432/yula_attribution

# Server-only HMAC key for the daily-rotating session pseudonym. Must be a
# long random string. There is NO fallback: hashing with a constant would
# produce a permanently joinable identifier, so a missing secret makes the
# events endpoint report storage as unavailable instead.
#   openssl rand -hex 32
ATTRIBUTION_SECRET=

# Database the attribution test-suite runs against. Defaults to
# postgres://localhost:5432/yula_attribution_test. These tests intentionally
# run against a real PostgreSQL — a fake store would accept the very rows
# the schema exists to reject, so a green run against one proves nothing.
#   createdb yula_attribution_test
ATTRIBUTION_TEST_DATABASE_URL=postgres://localhost:5432/yula_attribution_test

# Bearer token Vercel Cron sends to /api/purge, which enforces the 30-day
# raw-attribution retention promised on /privacy. Unset means the route
# refuses to run at all — a public endpoint that deletes rows must not be
# reachable just because nobody configured it.
#   openssl rand -hex 32
CRON_SECRET=

# --- Lead capture and mail -------------------------------------------------
# NOTHING BELOW MAY BE SET BEFORE THE LEGAL REVIEW AND MAIL DNS ARE DONE.
# These switches are what makes "we are not collecting" true today.

# Publishes the Studio route and its Header/Footer/Contact CTAs. Only the
# exact server-side value "true" enables it; unset, empty, false, 1 and
# unknown values mechanically roll the surface back to localized Contact.
STUDIO_ENABLED=

# Opens the lead form AND the /api/leads sink. Only the exact string "1".
# Default-closed on purpose: not publishing the form does not unpublish the
# sink, because middleware excludes /api and the route answers on the public
# internet the moment main deploys. Read from one place
# (src/server/lead-surface.ts) so the page and the route cannot disagree.
# Changing it needs a redeploy — the contact page is prerendered.
LEADS_ENABLED=

# Server-only key used to derive data-request verification capabilities from
# their request UUID. At least 32 UTF-8 bytes; never exposed as NEXT_PUBLIC_*.
# The outbox stores only the UUID pointer and re-derives the capability just
# before delivery, so neither this key nor a plaintext token is persisted.
#   openssl rand -hex 32
# Current HMAC key used to derive data-request verification capabilities.
# IDs are non-secret and stay on rows/outbox pointers; secrets are server-only.
DATA_REQUEST_TOKEN_CURRENT_KEY_ID=
DATA_REQUEST_TOKEN_CURRENT_SECRET=
# Optional one-key overlap for bounded rotation. Remove only after every row
# bearing this ID is delivered, expired or purged.
DATA_REQUEST_TOKEN_PREVIOUS_KEY_ID=
DATA_REQUEST_TOKEN_PREVIOUS_SECRET=

# Exact V1 transactional-mail identity. These values are server-only and are
# deliberately fail-closed: whitespace, a different value, or either legacy
# key (MAIL_FROM / LEADS_INTERNAL_ADDRESS) does not enable delivery.
YULA_MAIL_FROM=hello@yulalab.com
YULA_FROM_NAME=YULALAB
YULA_REPLY_TO=yula@yulalab.com
# Only lead_internal_route depends on this address. If it is unavailable,
# customer receipts and data-request verification can continue independently.
YULA_LEADS_INTERNAL_ADDRESS=yula@yulalab.com

# YULA_TEST_RECIPIENT is NOT runtime or Vercel config. A real external inbox is
# supplied only to the separately authorised provider-acceptance procedure.

# SendGrid. The transport reports itself UNCONFIGURED unless the API key and
# exact identity above are present. An unconfigured transport delivers nothing
# and marks nothing delivered — it does not even spend a row's retry budget,
# so a month of scheduled runs before credentials arrive leaves the queue intact.
#
# The template ids are part of that chain, not a detail: with a key and a
# sender but no template, SendGrid rejects an empty template_id, and on the
# daily schedule MAX_ATTEMPTS retires every receipt within five days —
# permanent loss reported as ordinary provider failures. `missingTemplates()`
# in src/server/mail.ts names whichever are absent.
SENDGRID_API_KEY=
SENDGRID_TEMPLATE_LEAD_RECEIPT_TR=d-cef2371a06014280857d0f17e3056305
SENDGRID_TEMPLATE_LEAD_RECEIPT_EN=d-d42d50b22fda48e49cfbb6ab373f420e
SENDGRID_TEMPLATE_DATA_REQUEST_VERIFICATION_TR=d-934e79bac8f841dfb7066e169d8f4ffc
SENDGRID_TEMPLATE_DATA_REQUEST_VERIFICATION_EN=d-e9aeeaa9dc8949679777b61eed0f41dc
# Only required once YULA_LEADS_INTERNAL_ADDRESS is valid.
SENDGRID_TEMPLATE_LEAD_INTERNAL_ROUTE_TR=d-2ce67d70cec249aeab61577361a50572

# NOT A VARIABLE, A KNOWN GAP: the roadmap's target is a receipt within 60
# seconds. /api/mail is scheduled daily in vercel.json, which is what the
# current plan allows — roughly four orders of magnitude off. Nothing
# published promises faster; the form says a copy was emailed only when the
# provider is actually configured. Sub-daily cron is a plan decision.
# Data-request durable-admission challenge (server-only provider secret).
DATA_REQUEST_CHALLENGE_PROVIDER=turnstile
DATA_REQUEST_CHALLENGE_SECRET=
DATA_REQUEST_CHALLENGE_HOSTNAME=yulalab.com
